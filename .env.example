# Use demo until your Supabase database is ready.
NEXT_PUBLIC_DATA_MODE=demo

# Add these when switching to Supabase mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# This is intentionally public and appears on the Settings page.
NEXT_PUBLIC_SUPPORT_EMAIL=replace-with-your-gmail@example.com
