# Mode: "supabase" for live Supabase PostgreSQL database, or "demo" for local sandbox mode.
NEXT_PUBLIC_DATA_MODE=supabase

# Supabase Credentials (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-Only Service Role Key (NEVER expose to the browser; used only in protected server API routes like account deletion)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Contact Support Email (displayed in Settings and legal pages)
NEXT_PUBLIC_SUPPORT_EMAIL=support@pantrypulse.app

# Canonical Site URL (used for sitemaps, robots.txt, and OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://pantrypulse.app
